# ─────────────────────────────────────────────
# ClinicOS API — environment variables
# Copy this file to .env and fill in the values:  cp .env.example .env
# Never commit .env (secrets). Only this example file is committed.
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ── Database (matches docker-compose.yml) ────
# In production the host is `db` (compose service name), not localhost
DATABASE_URL=postgresql://clinicos:clinicos@localhost:5432/clinicos

# ── Clinic ───────────────────────────────────
# IANA time zone that defines the clinic's "day" (all times stored in UTC)
CLINIC_TIME_ZONE=Asia/Dhaka
CLINIC_NAME=ClinicOS Demo Clinic
CLINIC_ADDRESS="123 Health Avenue, Dhaka"
CLINIC_PHONE="(555) 010-0100"

# ── Auth (Better Auth + JWT cookies) ─────────
# Generate each secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# Production only, e.g. .yourdomain.com (leave empty for localhost)
COOKIE_DOMAIN=

# ── Seed (the single super admin) ────────────
SUPER_ADMIN_NAME=Clinic Owner
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ── Email (patient invite, verification) ─────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ClinicOS <no-reply@yourdomain.com>"
PATIENT_INVITE_EXPIRES_HOURS=48

# ── Stripe (sandbox) ─────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...