{
	"name": "clinicos-api",
	"version": "1.0.0",
	"private": true,
	"description": "ClinicOS API — 24/7 hospital booking, live queue, consultation, prescription and billing backend (Express, Prisma, PostgreSQL)",
	"main": "dist/server.js",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/server.ts",
		"typecheck": "tsc",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"check": "pnpm typecheck && pnpm lint",
		"build": "tsdown",
		"start": "node --enable-source-maps dist/server.js",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"engines": {
		"node": ">=24 <25"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.18.0",
	"type": "module",
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"oxlint": "^1.92.0",
		"oxlint-tsgolint": "^7.0.2006",
		"prisma": "^7.10.1",
		"tsdown": "^0.23.7",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"express": "^5.3.0",
		"pg": "^8.23.1"
	}
}
