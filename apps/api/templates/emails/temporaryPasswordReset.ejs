<h1
	class="h1"
	style="
		margin: 0 0 12px 0;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 26px;
		line-height: 32px;
		font-weight: bold;
		color: #0f172a;
	"
>
	Your password has been reset
</h1>

<p style="margin: 0 0 24px 0">
	Hi <%= name %>, a <%= clinicName %> staff member has reset the password for your account. Sign in with the temporary
	password below. You will be asked to choose your own password right after you sign in.
</p>

<!-- credentials box -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: separate">
	<tr>
		<td style="padding: 20px 24px; background-color: #eff4ff; border: 1px solid #c7d7fe; border-radius: 12px">
			<div
				style="
					font-family: Arial, Helvetica, sans-serif;
					font-size: 12px;
					line-height: 16px;
					font-weight: bold;
					letter-spacing: 2px;
					color: #2563eb;
				"
			>
				EMAIL
			</div>
			<div
				style="
					padding: 4px 0 16px 0;
					font-family: Arial, Helvetica, sans-serif;
					font-size: 16px;
					line-height: 22px;
					color: #0f172a;
				"
			>
				<%= email %>
			</div>
			<div
				style="
					font-family: Arial, Helvetica, sans-serif;
					font-size: 12px;
					line-height: 16px;
					font-weight: bold;
					letter-spacing: 2px;
					color: #2563eb;
				"
			>
				TEMPORARY PASSWORD
			</div>
			<div
				style="
					padding-top: 4px;
					font-family: &quot;Courier New&quot;, Courier, monospace;
					font-size: 22px;
					line-height: 30px;
					font-weight: bold;
					letter-spacing: 2px;
					color: #0f172a;
				"
			>
				<%= temporaryPassword %>
			</div>
		</td>
	</tr>
</table>

<!-- button -->
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0">
	<tr>
		<td style="background-color: #2563eb; border-radius: 8px">
			<a
				href="<%= loginUrl %>"
				style="
					display: inline-block;
					padding: 12px 24px;
					font-family: Arial, Helvetica, sans-serif;
					font-size: 15px;
					font-weight: bold;
					color: #ffffff;
					text-decoration: none;
				"
				>Sign in</a
			>
		</td>
	</tr>
</table>

<p style="margin: 0 0 24px 0">
	For your safety, you have been signed out on every device. Your old password no longer works.
</p>

<!-- security note -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: separate">
	<tr>
		<td
			style="
				padding: 14px 16px;
				background-color: #fff1f2;
				border-radius: 10px;
				font-family: Arial, Helvetica, sans-serif;
				font-size: 14px;
				line-height: 21px;
				color: #475569;
			"
		>
			<strong style="color: #0f172a">Didn't ask for this?</strong> Contact <%= clinicName %> right away. Staff will never
			ask you for this password by phone or message.
		</td>
	</tr>
</table>
