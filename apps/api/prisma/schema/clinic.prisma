model Specialty {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  slug        String   @unique
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  doctorSpecialties DoctorSpecialty[]

  @@map("specialties")
}

model Patient {
  id       String @id @default(uuid())
  userId   String @unique
  fullName String

  phone       String?
  dateOfBirth DateTime? @db.Date
  gender      Gender?
  address     String?

  bloodGroup            BloodGroup?
  allergies             String?
  emergencyContactName  String?
  emergencyContactPhone String?

  registeredById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User  @relation("PatientAccount", fields: [userId], references: [id], onDelete: Cascade)
  registeredBy User? @relation("PatientRegisteredBy", fields: [registeredById], references: [id])

  @@index([phone])
  @@index([fullName])
  @@map("patients")
}

model DoctorProfile {
  id                   String  @id @default(uuid())
  userId               String  @unique
  licenseNumber        String  @unique
  consultationFeeCents Int
  roomNumber           String?
  isPaused             Boolean @default(false)
  slotMinutesDefault   Int     @default(15)
  bio                  String?
  photoUrl             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id])
  doctorSpecialties DoctorSpecialty[]

  @@map("doctor_profiles")
}

model DoctorSpecialty {
  doctorProfileId String
  specialtyId     String
  createdAt       DateTime @default(now())

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  specialty     Specialty     @relation(fields: [specialtyId], references: [id])

  @@id([doctorProfileId, specialtyId])
  @@index([specialtyId])
  @@map("doctor_specialties")
}
